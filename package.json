{
  "name": "scamfuse",
  "version": "0.2.0",
  "private": true,
  "description": "Browser extension that pauses the dangerous actions scammers push people into and asks someone they trust.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "demo": "node scripts/serve-demo.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
